pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        SERVICE_NAME  = 'job-offer-service'
        SERVICE_DIR   = '.'
        DOCKER_IMAGE  = 'ihebbe/job-offer-service'
        DOCKER_TAG    = "${BUILD_NUMBER}"
        SONAR_URL     = 'http://localhost:9000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Init') {
            steps {
                script {
                    env.SERVICE_DIR = fileExists('job-offer-service/pom.xml') ? 'job-offer-service' : '.'
                    echo "Using service directory: ${env.SERVICE_DIR}"
                }
            }
        }

        stage('Build') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    sh 'mvn -B clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    sh 'mvn -B test'
                }
            }
        }

        stage('Package') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    sh 'mvn -B -DskipTests package'
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar -Dsonar.projectKey=$SERVICE_NAME'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    script {
                        def dockerfile = fileExists('Dockerfile') ? 'Dockerfile' : 'Dokerfile'
                        sh """
                        docker build -f ${dockerfile} \
                        -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest
                        """
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                    docker push ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'CI job-offer-service succeeded 🚀'
        }
        failure {
            echo 'CI job-offer-service failed ❌'
        }
    }
}