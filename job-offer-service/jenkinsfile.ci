pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        SERVICE_NAME  = 'job-offer-service'
        SERVICE_DIR   = '.'
        DOCKER_IMAGE  = 'ihebbe/job-offer-service'
        DOCKER_TAG    = "${BUILD_NUMBER}"
        SONAR_URL     = 'http://sonarqube:9000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Init') {
            steps {
                script {
                    env.SERVICE_DIR = fileExists('job-offer-service/pom.xml') ? 'job-offer-service' : '.'
                    echo "Using service directory: ${env.SERVICE_DIR}"
                }
            }
        }

        stage('Build') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    sh 'mvn -B clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    sh 'mvn -B test'
                }
            }
        }

        stage('Package') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    sh 'mvn -B -DskipTests package'
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn clean verify sonar:sonar'
                    }
                }
            }
        }

        // ✅ SOLUTION 3 : Docker Pipeline Plugin (pas besoin du binaire docker)
        stage('Docker Build') {
            steps {
                dir("${env.SERVICE_DIR}") {
                    script {
                        // Utilisation du plugin Docker Pipeline au lieu de sh 'docker build...'
                        def app = docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")

                        // Tag supplémentaire :latest
                        app.tag("latest")

                        // On stocke l'image pour la réutiliser dans le stage Push
                        env.DOCKER_BUILT = 'true'
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    // Connexion à Docker Hub via les credentials Jenkins
                    docker.withRegistry('https://registry.hub.docker.com', 'dockerhub-credentials') {
                        def app = docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}")

                        // Push du tag numéroté
                        app.push()

                        // Push du tag latest
                        app.push('latest')
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'CI job-offer-service succeeded ✅'
        }
        failure {
            echo 'CI job-offer-service failed ❌'
        }
    }
}